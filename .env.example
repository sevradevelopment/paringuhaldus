# PostgreSQL (Neon / Vercel Marketplace)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
# AUTH_URL="https://www.paringuhaldus.ee"
# NEXT_PUBLIC_APP_URL="https://www.paringuhaldus.ee"

# Email (Resend) — optional; without it invites/quote email show honest errors
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Päringuhaldus.ee <onboarding@resend.dev>"

# Vercel Blob — optional; required for company logo upload
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Stripe — production uses LIVE keys; local/preview should use TEST keys
# Required for Checkout + Customer Portal + webhooks
# STRIPE_SECRET_KEY="sk_test_... or rk_live_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_... or pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
# Price IDs from Stripe Dashboard / API (flat-rate subscriptions)
# STRIPE_PRICE_STARTER_MONTHLY="price_..."
# STRIPE_PRICE_STARTER_YEARLY="price_..."
# STRIPE_PRICE_BUSINESS_MONTHLY="price_..."
# STRIPE_PRICE_BUSINESS_YEARLY="price_..."
# STRIPE_PRICE_PRO_MONTHLY="price_..."
# STRIPE_PRICE_PRO_YEARLY="price_..."
