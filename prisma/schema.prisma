generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum OrganizationPlan {
  STARTER
  BUSINESS
  PRO
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum InquiryStatus {
  UUS
  TOOS
  OOTEL
  LOPETATUD
  TYHISTATUD
}

enum InquiryPriority {
  MADAL
  TAVALINE
  KORGE
}

enum InquiryActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  ARCHIVED
  RESTORED
  CLIENT_LINKED
}

enum ClientActivityType {
  CREATED
  UPDATED
  ARCHIVED
  RESTORED
}

enum QuoteStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum QuoteActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  DUPLICATED
  ARCHIVED
  RESTORED
  SENT_EMAIL
  VERSIONED
}

model User {
  id                String              @id @default(cuid())
  name              String?
  email             String              @unique
  emailVerified     DateTime?
  image             String?
  passwordHash      String
  isSuperAdmin      Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  accounts          Account[]
  sessions          Session[]
  memberships       Membership[]
  inquiryNotes      InquiryNote[]
  inquiryActivities InquiryActivity[]
  clientActivities  ClientActivity[]
  quoteActivities   QuoteActivity[]
  quoteSendLogs     QuoteSendLog[]
  invitesSent       OrganizationInvite[] @relation("InviteSender")
}

model Organization {
  id                   String               @id @default(cuid())
  name                 String
  slug                 String               @unique
  plan                 OrganizationPlan     @default(STARTER)
  subscriptionStatus   SubscriptionStatus   @default(NONE)
  billingInterval      BillingInterval?
  stripeCustomerId     String?              @unique
  stripeSubscriptionId String?              @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  registryCode         String?
  vatNumber            String?
  address              String?
  email                String?
  phone                String?
  logoUrl              String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  memberships          Membership[]
  clients              Client[]
  inquiries            Inquiry[]
  quotes               Quote[]
  inquiryNotes         InquiryNote[]
  inquiryActivities    InquiryActivity[]
  clientActivities     ClientActivity[]
  quoteLineItems       QuoteLineItem[]
  quoteActivities      QuoteActivity[]
  quoteSendLogs        QuoteSendLog[]
  invites              OrganizationInvite[]
}

model Client {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  companyName    String?
  email          String?
  phone          String?
  registryCode   String?
  notes          String?          @db.Text
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inquiries      Inquiry[]
  activities     ClientActivity[]
  quotes         Quote[]

  @@index([organizationId])
  @@index([organizationId, name])
  @@index([organizationId, archivedAt])
  @@index([organizationId, email])
  @@index([organizationId, companyName])
}

model ClientActivity {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String
  actorId        String?
  type           ClientActivityType
  message        String
  meta           Json?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  actor          User?              @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([clientId, createdAt])
}

model Inquiry {
  id             String             @id @default(cuid())
  organizationId String
  clientId       String?
  title          String
  description    String?            @db.Text
  status         InquiryStatus      @default(UUS)
  priority       InquiryPriority    @default(TAVALINE)
  archivedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  quotes         Quote[]
  notes          InquiryNote[]
  activities     InquiryActivity[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, archivedAt])
  @@index([organizationId, priority])
  @@index([clientId])
}

model InquiryNote {
  id             String       @id @default(cuid())
  organizationId String
  inquiryId      String
  authorId       String?
  body           String       @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inquiry        Inquiry      @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([inquiryId, createdAt])
}

model InquiryActivity {
  id             String              @id @default(cuid())
  organizationId String
  inquiryId      String
  actorId        String?
  type           InquiryActivityType
  message        String
  meta           Json?
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inquiry        Inquiry             @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  actor          User?               @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([inquiryId, createdAt])
}

model Quote {
  id             String           @id @default(cuid())
  organizationId String
  clientId       String?
  inquiryId      String?
  number         String
  title          String
  description    String?          @db.Text
  status         QuoteStatus      @default(PENDING)
  issueDate      DateTime         @default(now())
  validUntil     DateTime?
  subtotal       Decimal          @db.Decimal(14, 2) @default(0)
  vatTotal       Decimal          @db.Decimal(14, 2) @default(0)
  total          Decimal          @db.Decimal(14, 2) @default(0)
  version        Int              @default(1)
  rootQuoteId    String?
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?          @relation(fields: [clientId], references: [id], onDelete: SetNull)
  inquiry        Inquiry?         @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  lineItems      QuoteLineItem[]
  activities     QuoteActivity[]
  sendLogs       QuoteSendLog[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, archivedAt])
  @@index([clientId])
  @@index([inquiryId])
}

model QuoteLineItem {
  id             String       @id @default(cuid())
  organizationId String
  quoteId        String
  name           String
  quantity       Decimal      @db.Decimal(14, 4)
  unitPrice      Decimal      @db.Decimal(14, 4)
  vatRate        Decimal      @db.Decimal(5, 2)
  lineSubtotal   Decimal      @db.Decimal(14, 2)
  lineVat        Decimal      @db.Decimal(14, 2)
  lineTotal      Decimal      @db.Decimal(14, 2)
  position       Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([quoteId, position])
}

model QuoteActivity {
  id             String            @id @default(cuid())
  organizationId String
  quoteId        String
  actorId        String?
  type           QuoteActivityType
  message        String
  meta           Json?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          Quote             @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actor          User?             @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([quoteId, createdAt])
}

model QuoteSendLog {
  id             String       @id @default(cuid())
  organizationId String
  quoteId        String
  actorId        String?
  toEmail        String
  subject        String
  success        Boolean
  errorMessage   String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([quoteId, createdAt])
}

model OrganizationInvite {
  id             String         @id @default(cuid())
  organizationId String
  email          String
  role           MembershipRole @default(MEMBER)
  tokenHash      String         @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  invitedById    String?
  createdAt      DateTime       @default(now())
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User?          @relation("InviteSender", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([email])
}

model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
  payload     Json?

  @@index([type])
}

model Membership {
  id             String         @id @default(cuid())
  role           MembershipRole @default(MEMBER)
  userId         String
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
